{
  "name": "sistema-entregas-api",
  "version": "1.0.0",
  "private": true,
  "description": "API do Sistema de Entregas (Grupo 7) - Trabalho de Integração de Aplicações por Arquivos CSV",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "docs:generate": "tsx src/docs/generate_openapi_file.ts",
    "docs:postman": "tsx src/docs/generate_postman_collection.ts",
    "docs": "npm run docs:generate && npm run docs:postman"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.4",
    "@types/swagger-ui-express": "^4.1.6",
    "openapi-to-postmanv2": "^4.22.0",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
